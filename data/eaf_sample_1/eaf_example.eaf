    <TIER ANNOTATOR="WSilva" DEFAULT_LOCALE="en"
        LINGUISTIC_TYPE_REF="translation" PARENT_REF="JBMassa-des"
        PARTICIPANT="JBMassa" TIER_ID="Traducao">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a163" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Eu vou contar uma estória para voces.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a164" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Sabe o que aconteceu nessa cachoeira antigamente?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a165" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Voces tambem querem saber essa estoria.Os velhos ja a conhecem..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a166" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Estou dizendo (me refiro) a esta cachoeira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a167" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Esta cachoeira nos ilumina, sabe?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a168" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Por isso vou contar para voces mais rápido (um resumo)..</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a169" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Esta estória, antes de existir a cachoeira, aconteceu assim.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a170" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Esta aranha sera o primo-irmão-materno dele</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a171" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>O pai (rei) dos peixes, como eles chamam, mandou extrair 'wahsu', eles (nos) disseram</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a172" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Era nas vesperas do dia da danca</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a173" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Ele aceitou, depois chegou lá</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a174" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Estou dizendo que só ele sabia, tinha habilidade.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a175" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Ele era mais habil na extracao do wahsu que eles usam durante a danca</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a176" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Ele era bom em pintar/desenhar</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a177" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Assim, chegando a véspera, faltando tres dias, entregou (o wahsu)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a178" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Ele (aranha) entregou um rolo pequenininho, deste tamaninho, para seu primo-irmão</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a179" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>"-Poxa, eu não estava querendo tão pouquinho."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a180" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Disse: "-estava querendo muito."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a181" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Dizendo assim, deu um tapa na aranha.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a182" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Vendo isso, após dar o tapa, (o pai dos peixes) mandou (a aranha) abrir a boca e quebrar os dentes para fora.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a183" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Por a aranha tem esse tipo de dente.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a184" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
